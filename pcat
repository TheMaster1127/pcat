import os
import sys
import argparse
import subprocess
import fnmatch
import time
import re
from pathlib import Path

try:
    from colorama import init, Fore, Style
    init(autoreset=True)
except ImportError:
    class Fore: RED=''; GREEN=''; YELLOW=''; BLUE=''; MAGENTA=''; CYAN=''; RESET=''
    class Style: BRIGHT=''; RESET_ALL=''

def parse_size(s):
    """Convert human size like '50k', '2.3MB', '600b' to bytes. Case-insensitive."""
    s = s.strip().lower()
    if not s:
        return 0
    match = re.match(r'^([\d.]+)\s*([kmgt]?i?b?)$', s)
    if not match:
        try:
            return int(s)
        except:
            return 0
    num = float(match.group(1))
    unit = match.group(2)
    if unit in ('b', ''):
        return int(num)
    if unit in ('k', 'kb', 'kib'):
        return int(num * 1024)
    if unit in ('m', 'mb', 'mib'):
        return int(num * 1024 * 1024)
    if unit in ('g', 'gb', 'gib'):
        return int(num * 1024 * 1024 * 1024)
    if unit in ('t', 'tb', 'tib'):
        return int(num * 1024 * 1024 * 1024 * 1024)
    return 0

def expand_patterns(opt_list):
    """Split comma-separated patterns into a flat list, stripping whitespace."""
    patterns = []
    if not opt_list:
        return patterns
    for item in opt_list:
        if ',' in item:
            for part in item.split(','):
                pat = part.strip()
                if pat:
                    patterns.append(pat)
        else:
            pat = item.strip()
            if pat:
                patterns.append(pat)
    return patterns

def is_binary(filepath):
    try:
        with open(filepath, 'rb') as f:
            return b'\0' in f.read(1024)
    except:
        return True

def should_include_file(filepath, include_patterns):
    if not include_patterns:
        return True
    name = str(filepath)
    basename = os.path.basename(name)
    for pat in include_patterns:
        if fnmatch.fnmatch(name, pat) or fnmatch.fnmatch(basename, pat):
            return True
    return False

def should_exclude_file(filepath, exclude_patterns):
    if not exclude_patterns:
        return False
    name = str(filepath)
    basename = os.path.basename(name)
    for pat in exclude_patterns:
        if fnmatch.fnmatch(name, pat) or fnmatch.fnmatch(basename, pat):
            return True
    return False

def should_include_dir(dirpath, include_dir_patterns):
    if not include_dir_patterns:
        return True
    name = str(dirpath)
    basename = os.path.basename(name)
    for pat in include_dir_patterns:
        if fnmatch.fnmatch(name, pat) or fnmatch.fnmatch(basename, pat):
            return True
    return False

def should_exclude_dir(dirpath, exclude_dir_patterns):
    if not exclude_dir_patterns:
        return False
    name = str(dirpath)
    basename = os.path.basename(name)
    for pat in exclude_dir_patterns:
        if fnmatch.fnmatch(name, pat) or fnmatch.fnmatch(basename, pat):
            return True
    return False

def collect_files(paths, recursive, include, exclude, include_dir, exclude_dir):
    results = []
    for p in paths:
        if p == '-':
            results.append(('stdin', '-'))
            continue

        path = Path(p)
        if not path.exists():
            results.append(('error', f"pcat: {p}: No such file or directory"))
            continue
        if path.is_file():
            if should_include_file(path, include) and not should_exclude_file(path, exclude):
                results.append(('file', path))
        elif path.is_dir():
            if recursive:
                for root, dirs, files in os.walk(path):
                    # Filter directories in place
                    if include_dir or exclude_dir:
                        dirs[:] = [d for d in dirs if should_include_dir(Path(root)/d, include_dir) and not should_exclude_dir(Path(root)/d, exclude_dir)]
                    for f in files:
                        full = Path(root) / f
                        if should_include_file(full, include) and not should_exclude_file(full, exclude):
                            results.append(('file', full))
            else:
                results.append(('error', f"pcat: {p}: Is a directory (use -r)"))
    return results

def output_file(filepath, args, is_stdin=False):
    if not is_stdin:
        # Size filters
        if args.min_size > 0:
            try:
                if os.path.getsize(filepath) < args.min_size:
                    return
            except:
                return
        if args.max_size > 0:
            try:
                if os.path.getsize(filepath) > args.max_size:
                    return
            except:
                return

    # Read content
    try:
        if is_stdin:
            content = sys.stdin.read()
            lines = content.splitlines()
        else:
            if is_binary(filepath):
                return
            with open(filepath, 'r', encoding='utf-8', errors='replace') as f:
                content = f.read()
                lines = content.splitlines()
    except:
        return

    # Character count filters
    char_count = len(content)
    if args.min_chars > 0 and char_count < args.min_chars:
        return
    if args.max_chars > 0 and char_count > args.max_chars:
        return

    # Line count filters
    line_count = len(lines)
    if args.min_lines > 0 and line_count < args.min_lines:
        return
    if args.max_lines > 0 and line_count > args.max_lines:
        return

    # Header
    if not is_stdin:
        sep = args.separator
        header = f"{sep} {filepath} {sep}"
        print(f"{Fore.CYAN}{Style.BRIGHT}{header}{Style.RESET_ALL}" if args.color else header)

    # Process lines
    start = max(0, args.start_line - 1)
    lines = lines[start:]
    if args.max_len > 0:
        lines = [l[:args.max_len] + ('…' if len(l) > args.max_len else '') for l in lines]
    
    # Enumerate starting from 1 for the displayed lines, as documented
    for idx, line in enumerate(lines, start=1):
        if args.line_num:
            print(f"{Fore.GREEN}{idx:4} {Style.RESET_ALL}" if args.color else f"{idx:4} ", end="")
        print(line)
        
    if not is_stdin:
        print()

def follow_file(filepath, args):
    file_existed_at_start = os.path.exists(filepath)
    
    if not file_existed_at_start:
        msg = f"Waiting for {filepath} to appear... (Ctrl+C to stop)"
        print(f"{Fore.MAGENTA}{msg}{Style.RESET_ALL}" if args.color else msg, flush=True)
        while not os.path.exists(filepath):
            time.sleep(0.5)
    
    msg = f"Following {filepath} (Ctrl+C to stop)"
    print(f"{Fore.MAGENTA}{msg}{Style.RESET_ALL}" if args.color else msg, flush=True)
    
    try:
        with open(filepath, 'r', encoding='utf-8', errors='replace') as f:
            # If the file already existed when we started the command, skip to the end (standard tail -f).
            # If the file is brand new (just created), start from the beginning to capture the first write!
            if file_existed_at_start:
                f.seek(0, os.SEEK_END)
            
            while True:
                curr_pos = f.tell()
                line = f.readline()
                if not line:
                    time.sleep(0.1)
                    # Check for truncation (log rotation)
                    if os.path.exists(filepath) and os.path.getsize(filepath) < curr_pos:
                        f.seek(0, os.SEEK_SET)
                    continue
                
                line = line.rstrip('\n\r')
                if args.max_len > 0 and len(line) > args.max_len:
                    line = line[:args.max_len] + '…'
                print(line, flush=True)
    except KeyboardInterrupt:
        print()
    except PermissionError:
        print(f"pcat: {filepath}: Permission denied", file=sys.stderr)
        sys.exit(1)

def main():
    p = argparse.ArgumentParser(description="pcat - pretty cat", add_help=False)
    p.add_argument('files', nargs='*')
    p.add_argument('-n', '--line-num', action='store_true', help='show line numbers')
    p.add_argument('-c', '--color', action='store_true', help='color output')
    p.add_argument('-r', '--recursive', action='store_true', help='recurse dirs')
    p.add_argument('-x', '--exclude', action='append', default=[], help='exclude file patterns (comma-separated)')
    p.add_argument('-i', '--include', action='append', default=[], help='include only file patterns (comma-separated)')
    p.add_argument('-xd', '--exclude-dir', action='append', default=[], help='exclude directory patterns when recursing')
    p.add_argument('-id', '--include-dir', action='append', default=[], help='include only directory patterns when recursing')
    p.add_argument('-S', '--separator', default='==========', help='header separator')
    p.add_argument('-l', '--start-line', type=int, default=1, help='start at line N')
    p.add_argument('-f', '--follow', action='store_true', help='tail -f mode (single file)')
    p.add_argument('-w', '--max-len', type=int, default=0, help='truncate lines longer than N')
    p.add_argument('-p', '--page', action='store_true', help='pipe to pager')
    p.add_argument('--min-size', type=str, default='', help='minimum file size (e.g., 50k, 2MB, 600b)')
    p.add_argument('--max-size', type=str, default='', help='maximum file size')
    p.add_argument('--min-lines', type=int, default=0, help='minimum line count')
    p.add_argument('--max-lines', type=int, default=0, help='maximum line count')
    p.add_argument('--min-chars', type=int, default=0, help='minimum character count')
    p.add_argument('--max-chars', type=int, default=0, help='maximum character count')
    p.add_argument('--pager-cmd', default='less -R' if sys.platform != 'win32' else 'more', help='pager command')
    p.add_argument('-h', '--help', action='help')
    p.add_argument('--version', action='version', version='pcat 1.1.0')
    args = p.parse_args()

    # Convert size arguments
    args.min_size = parse_size(args.min_size) if args.min_size else 0
    args.max_size = parse_size(args.max_size) if args.max_size else 0

    # Expand patterns
    include_patterns = expand_patterns(args.include)
    exclude_patterns = expand_patterns(args.exclude)
    include_dir_patterns = expand_patterns(args.include_dir)
    exclude_dir_patterns = expand_patterns(args.exclude_dir)

    if not args.files:
        output_file(None, args, is_stdin=True)
        return

    if args.follow:
        if len(args.files) != 1 or args.files[0] == '-':
            print("Error: --follow needs exactly one file", file=sys.stderr)
            sys.exit(1)
        follow_file(args.files[0], args)
        return

    files = collect_files(args.files, args.recursive, include_patterns, exclude_patterns,
                          include_dir_patterns, exclude_dir_patterns)
    if args.page:
        proc = subprocess.Popen(args.pager_cmd.split(), stdin=subprocess.PIPE, text=True, encoding='utf-8', errors='replace')
        sys.stdout = proc.stdin

    try:
        for typ, item in files:
            if typ == 'error':
                print(item, file=sys.stderr)
            elif typ == 'stdin':
                output_file(None, args, is_stdin=True)
            else:
                output_file(item, args)
    except BrokenPipeError:
        pass
    finally:
        if args.page:
            sys.stdout = sys.__stdout__
            proc.stdin.close()
            proc.wait()

if __name__ == '__main__':
    main()
